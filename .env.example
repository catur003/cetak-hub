# =============================================================================
# .env.example - CetakPro
# Isi APA ADANYA di sini itu contoh/placeholder - jangan dipakai langsung ke
# production. Copy ke .env, isi nilai asli, JANGAN commit .env ke git.
# =============================================================================

# --- Identitas & mode app ---
APP_NAME=CetakPro
APP_ENV=production
# APP_KEY: kunci enkripsi utama Laravel (session, cookie, encrypt()/decrypt()).
# JANGAN diisi manual - generate lewat `php artisan key:generate --show`,
# baru tempel hasilnya di sini. Ganti APP_KEY di app yang UDAH JALAN = semua
# session/cookie/data ter-enkripsi lama jadi gak kebaca lagi (lihat diskusi
# ZenVPS soal alur 2-langkah generate->terapkan).
APP_KEY=
# APP_DEBUG: WAJIB false di production - true bakal nampilin stack trace
# lengkap (path server, query SQL, dst) ke publik kalau ada error.
APP_DEBUG=false
# APP_URL: domain final app ini. Diisi SETELAH domain di-set di Coolify
# (Dashboard Coolify -> app -> Domains), BUKAN URL Railway - project ini
# dipindah ke Coolify, bukan Railway (lihat SETUP.md versi lama).
APP_URL=https://cetak-pro.contoh-domain.com

# --- Database ---
# DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD: kalau pakai Container Database
# Coolify, nilai ini didapat OTOMATIS dari Coolify (connection string
# di-generate pas bikin resource database) - tinggal copy dari situ, jangan
# ngarang sendiri.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session ---
# SESSION_DRIVER=database berarti Laravel nyimpen session di tabel
# `sessions` di database, BUKAN di file lokal container (penting karena
# container Coolify stateless - file session bakal ILANG tiap redeploy
# kalau pakai driver "file"). WAJIB jalanin migration `sessions` table.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_SECURE_COOKIE=true WAJIB kalau app diakses via https (cookie
# session gak bakal dikirim browser kalau true tapi diakses via http biasa -
# pastikan domain di Coolify udah aktif SSL-nya dulu sebelum set true).
SESSION_SECURE_COOKIE=true

# --- Cloudinary (penyimpanan gambar produk) ---
# CLOUDINARY_URL: 1 string gabungan (bukan dipecah kayak DB) - ambil dari
# Cloudinary Dashboard -> Account Details -> "API Environment variable".
# Formatnya: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Midtrans (payment gateway) ---
# Ambil dari Dashboard Midtrans -> Settings -> Access Keys. ADA 2 SET beda:
# Sandbox (buat testing, transaksi gak beneran motong uang) dan Production
# (transaksi ASLI). Field MIDTRANS_IS_PRODUCTION nentuin mana yang dipakai.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION: WAJIB false selama masih testing/development.
# Ganti true CUMA kalau app udah siap terima transaksi uang beneran, dan
# pastikan SERVER_KEY/CLIENT_KEY di atas juga udah versi Production
# (bukan Sandbox) - salah pasang bikin transaksi gagal terus.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# =============================================================================
# CATATAN BUAT DEPLOY DI COOLIFY (bukan bagian file .env, cuma pengingat):
#
# 1. NIXPACKS_PHP_ROOT_DIR=/app/public - set ini sebagai environment variable
#    TERPISAH di Coolify (Dashboard -> app -> Environment Variables), BUKAN
#    di .env - ini variable buat proses BUILD Nixpacks, bukan runtime app.
#    Laravel serve dari folder public/, kalau ini kelewat, app bakal expose
#    seluruh source code (termasuk .env) ke publik.
# 2. Ports Exposes: isi 80 (nginx yang listen, bukan PHP langsung) - lihat
#    nixpacks.toml, beda dari Next.js yang isinya 3000.
# 3. Field "Post-deployment Command" di Coolify, isi buat tiap kali deploy:
#    php artisan migrate --force && php artisan config:cache && php artisan route:cache
#    ("--force" WAJIB di production, Laravel nolak migrate tanpa itu kalau
#    APP_ENV=production, demi mencegah migrate gak sengaja)
# =============================================================================
